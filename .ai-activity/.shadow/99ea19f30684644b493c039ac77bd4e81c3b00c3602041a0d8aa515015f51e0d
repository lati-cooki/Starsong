import SwiftUI

/// Choosing a voice for the line you're drawing on. Every voice can be heard
/// before you commit to it, which matters more here than in the atlas: these
/// are synthesised, and a name like "Brass" promises more than it delivers.
struct InstrumentView: View {
    let current: Instrument
    /// Which voice each line is currently using, for the colour dots.
    let inUse: [Instrument]
    let onChoose: (Instrument) -> Void
    @Environment(\.dismiss) private var dismiss

    var body: some View {
        NavigationStack {
            List(Instrument.allCases) { instrument in
                Button {
                    onChoose(instrument)
                    dismiss()
                } label: {
                    row(instrument)
                }
                .buttonStyle(.plain)
                .listRowBackground(Color.white.opacity(0.04))
            }
            .listStyle(.plain)
            .scrollContentBackground(.hidden)
            .background(
                LinearGradient(colors: [Palette.nightTop, Palette.nightBottom],
                               startPoint: .top, endPoint: .bottom)
                    .ignoresSafeArea()
            )
            .navigationTitle("Voices")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .confirmationAction) {
                    Button("Done") { dismiss() }
                }
            }
        }
        .preferredColorScheme(.dark)
    }

    private func row(_ instrument: Instrument) -> some View {
        HStack(spacing: 12) {
            Image(systemName: instrument == current ? "checkmark.circle.fill" : "circle")
                .font(.system(size: 18))
                .foregroundStyle(instrument == current ? Palette.gold : Palette.ink.opacity(0.3))

            VStack(alignment: .leading, spacing: 3) {
                HStack(spacing: 6) {
                    Text(instrument.name)
                        .font(.system(size: 17, weight: .semibold, design: .serif))
                        .foregroundStyle(Palette.gold)
                    // A dot per line already playing this voice, in its colour.
                    ForEach(Array(inUse.enumerated()), id: \.offset) { index, voice in
                        if voice == instrument {
                            Circle()
                                .fill(Palette.line(index))
                                .frame(width: 6, height: 6)
                        }
                    }
                }
                Text(instrument.blurb)
                    .font(.system(size: 13))
                    .foregroundStyle(Palette.ink.opacity(0.75))
                    .fixedSize(horizontal: false, vertical: true)
            }
            Spacer(minLength: 0)
            HearButton { Self.audition(instrument) }
        }
        .padding(.vertical, 6)
        .contentShape(Rectangle())
        .accessibilityElement(children: .ignore)
        .accessibilityLabel(instrument.name)
        .accessibilityValue(instrument == current ? "Selected" : "")
        .accessibilityHint(instrument.blurb)
        .accessibilityAddTraits(instrument == current ? [.isButton, .isSelected] : .isButton)
    }

    /// A short rising phrase, so voices can be compared on the same notes.
    static func audition(_ instrument: Instrument) {
        let phrase: [CGFloat] = [0.72, 0.58, 0.44, 0.30]
        for (i, height) in phrase.enumerated() {
            let pan = Float((Double(i) / Double(phrase.count - 1)) - 0.5) * 1.2
            Synth.shared.ping(Music.pitch(forY: height),
                              instrument: instrument,
                              delay: Double(i) * Music.pulse,
                              duration: i == phrase.count - 1 ? 1.8 : 0.9,
                              volume: 0.24,
                              pan: pan)
        }
    }
}
