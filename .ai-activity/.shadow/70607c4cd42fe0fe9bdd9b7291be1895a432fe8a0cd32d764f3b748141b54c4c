import CoreGraphics
import Foundation
import Observation

/// Deterministic RNG so a sky can be reproduced from a seed (and tested).
struct SplitMix64: RandomNumberGenerator {
    private var state: UInt64
    init(seed: UInt64) { state = seed }

    mutating func next() -> UInt64 {
        state &+= 0x9E37_79B9_7F4A_7C15
        var z = state
        z = (z ^ (z >> 30)) &* 0xBF58_476D_1CE4_E5B9
        z = (z ^ (z >> 27)) &* 0x94D0_49BB_1331_11EB
        return z ^ (z >> 31)
    }
}

/// Everything the sky knows: the stars, the constellation being drawn on top of
/// them, and the transient sparkle. Owns playback and naming too, so the views
/// stay a pure function of this state.
@MainActor
@Observable
final class SkyModel {
    private(set) var stars: [Star] = []
    /// Each line is a constellation and the voice it is played in. There is
    /// always at least one, even when it is empty.
    private(set) var lines: [Line] = [Line()]
    /// The line being drawn on. New stars join this one.
    private(set) var activeLine = 0
    /// A plain constant, readable from anywhere — being a member of a
    /// @MainActor type would otherwise isolate it, which is an error under
    /// the Swift 6 language mode.
    nonisolated static let maxLines = 3

    /// The line being drawn on, which is what most of the app means by "the
    /// constellation".
    var path: [Int] {
        get { lines.indices.contains(activeLine) ? lines[activeLine].stars : [] }
        set {
            guard lines.indices.contains(activeLine) else { return }
            lines[activeLine].stars = newValue
        }
    }

    /// The voice the line being drawn on is played in.
    var instrument: Instrument {
        lines.indices.contains(activeLine) ? lines[activeLine].instrument : .chime
    }

    /// Just the shapes, for anything comparing constellations rather than voices.
    var lineStars: [[Int]] { lines.map(\.stars) }

    /// Every star on any line, for asking whether one is still in use.
    var connectedStars: [Int] { lines.flatMap(\.stars) }

    func setInstrument(_ instrument: Instrument, on line: Int? = nil) {
        let target = line ?? activeLine
        guard lines.indices.contains(target), lines[target].instrument != instrument else { return }
        lines[target].instrument = instrument
        keptID = nil
        // So you hear what you just chose, without having to press anything.
        if let star = lines[target].stars.last, stars.indices.contains(star) {
            let pan = Float(stars[star].x - 0.5) * 1.4
            Synth.shared.ping(Music.pitch(forY: stars[star].y, in: tuning),
                              instrument: instrument, duration: 1.0, volume: 0.22, pan: pan)
        }
    }
    private(set) var pulses: [Pulse] = []
    private(set) var shooters: [Shooter] = []

    private(set) var myth: Namer.Myth?
    /// Set when the name on screen was settled deliberately — typed by hand, or
    /// carried in from a sky that was kept — rather than being the last thing
    /// Claude happened to say. Asking Claude again offers to leave it alone.
    private(set) var nameIsMine = false
    private(set) var isNaming = false
    private(set) var isPlaying = false
    /// Bumped on every new connection; drives the haptic tick.
    private(set) var connections = 0

    private(set) var seed: UInt64 = 0
    /// Random background stars. A placed figure's stars sit after these.
    private(set) var fieldStarCount = 0
    private(set) var figureID: String?
    /// This night's tuning, chosen by its seed.
    private(set) var tuning = Music.default
    /// Bumped as each note of a melody sounds, so playback can be felt as well
    /// as heard.
    private(set) var notePulse = 0

    /// Where the star-by-star navigation is sitting, as an index into
    /// `navigationOrder`. Only used by assistive navigation, but drawn so it can
    /// be seen — and so it can be tested.
    private(set) var cursorSlot: Int?
    /// Every star, ordered low note to high note. Scanning the sky by pitch is
    /// far more useful than scanning it by position when you cannot see it.
    private(set) var navigationOrder: [Int] = []
    /// Set when the current constellation has been written to the log, so the
    /// "keep" affordance can step out of the way. Cleared by any change to it.
    private(set) var keptID: UUID?

    private var loopTasks: [Int: Task<Void, Never>] = [:]
    private var namingTask: Task<Void, Never>?
    /// Set once the player has begun a fresh line during this take, so touching
    /// more stars extends it rather than starting another.
    private var openedLineThisTake = false


    var pathStars: [Star] { stars(on: activeLine) }
    func stars(on line: Int) -> [Star] {
        guard lines.indices.contains(line) else { return [] }
        return lines[line].stars.compactMap { stars.indices.contains($0) ? stars[$0] : nil }
    }
    /// Every line with enough stars to sing.
    var singableLines: [Int] { lines.indices.filter { lines[$0].stars.count >= 2 } }
    var hasSomethingToPlay: Bool { !singableLines.isEmpty }
    var canPlay: Bool { hasSomethingToPlay }
    var canName: Bool { path.count >= 2 && !isNaming }
    var canAddLine: Bool { lines.count < Self.maxLines && path.count >= 2 }

    // MARK: - Sky

    func newSky(for size: CGSize, seed: UInt64? = nil) {
        stop()
        namingTask?.cancel()
        isNaming = false
        pulses = []
        myth = nil
        nameIsMine = false

        keptID = nil
        // A new sky keeps the voice you were last playing in.
        lines = [Line(instrument: instrument)]
        activeLine = 0
        let resolved = seed ?? UInt64.random(in: .min ... .max)
        makeSky(seed: resolved, count: Self.starCount(for: size))
    }

    private func makeSky(seed: UInt64, count: Int, figure: Figure? = nil) {
        self.seed = seed
        self.fieldStarCount = count
        self.figureID = figure?.id
        self.tuning = Music.tuning(for: seed)
        var rng = SplitMix64(seed: seed)
        stars = Self.makeStars(count: count, using: &rng)
        if let figure { stars.append(contentsOf: figure.placedStars()) }
        navigationOrder = Self.order(of: stars)
        cursorSlot = nil
    }

    /// Lowest note first, so swiping up walks up the sky and up the scale.
    nonisolated static func order(of stars: [Star]) -> [Int] {
        stars.indices.sorted { a, b in
            if stars[a].y != stars[b].y { return stars[a].y > stars[b].y }
            return stars[a].x < stars[b].x
        }
    }

    // MARK: - Finding a star without seeing it

    var cursorStar: Int? {
        guard let cursorSlot, navigationOrder.indices.contains(cursorSlot) else { return nil }
        return navigationOrder[cursorSlot]
    }

    /// What the focused star should say when it is announced.
    var cursorDescription: String {
        guard let index = cursorStar else {
            return stars.isEmpty ? "An empty sky" : "\(stars.count) stars. Swipe up to begin."
        }
        let star = stars[index]
        var parts = [Music.noteName(forY: star.y, in: tuning), Self.place(of: star)]
        if path.contains(index) { parts.append("already on the line") }
        parts.append("star \((cursorSlot ?? 0) + 1) of \(stars.count)")
        return parts.joined(separator: ", ")
    }

    nonisolated static func place(of star: Star) -> String {
        let vertical = star.y < 0.34 ? "upper" : (star.y > 0.66 ? "lower" : "middle")
        let horizontal = star.x < 0.34 ? "left" : (star.x > 0.66 ? "right" : "centre")
        return vertical == "middle" && horizontal == "centre" ? "centre" : "\(vertical) \(horizontal)"
    }

    /// Steps through the sky by pitch, sounding each star as it arrives, so the
    /// sky can be scanned by ear. Stops at either end rather than wrapping.
    @discardableResult
    func moveCursor(by delta: Int) -> Bool {
        guard !navigationOrder.isEmpty else { return false }
        let next: Int
        if let cursorSlot {
            next = min(max(cursorSlot + delta, 0), navigationOrder.count - 1)
            if next == cursorSlot { return false }
        } else {
            next = delta > 0 ? 0 : navigationOrder.count - 1
        }
        cursorSlot = next
        let star = stars[navigationOrder[next]]
        let pan = Float(star.x - 0.5) * 1.4
        Synth.shared.ping(Music.pitch(forY: star.y, in: tuning), instrument: instrument,
                          duration: 0.5, volume: 0.18, pan: pan)
        return true
    }

    // MARK: - Naming it yourself

    /// Names the constellation by hand.
    ///
    /// Keeps whatever story is already there: renaming a myth Claude told
    /// should not throw the myth away, and a name typed with no story at all is
    /// still a perfectly good thing to keep — `SavedSky.isCoherent` asks for a
    /// name, not a story.
    ///
    /// `keptID` deliberately survives, so renaming something already in the log
    /// updates that entry in place instead of orphaning it.
    func rename(_ name: String) {
        let trimmed = name.trimmingCharacters(in: .whitespacesAndNewlines)
        guard trimmed != (myth?.name ?? "") else { return }

        guard !trimmed.isEmpty else {
            // Clearing the name hands the constellation back to Claude, or to
            // the offline fallback if there is no key.
            myth = nil
            nameIsMine = false
            return
        }
        myth = Namer.Myth(name: trimmed, myth: myth?.myth ?? "")
        nameIsMine = true
    }

    /// Adds whatever the cursor is sitting on.
    @discardableResult
    func connectCursor() -> Bool {
        guard let index = cursorStar else { return moveCursor(by: 1) }
        return connect(starAt: index)
    }

    /// Lays a real constellation over a fresh field of invented stars, already
    /// drawn, so you can hear what Orion sounds like.
    func place(_ figure: Figure, for size: CGSize, seed: UInt64? = nil) {
        guard figure.isCoherent else { return }
        stop()
        namingTask?.cancel()
        isNaming = false
        pulses = []
        keptID = nil

        let field = Self.starCount(for: size)
        makeSky(seed: seed ?? UInt64.random(in: .min ... .max), count: field, figure: figure)
        lines = [Line(stars: figure.walk.map { field + $0 }, instrument: instrument)]
        activeLine = 0
        // A real constellation arrives with the name it has had for millennia,
        // which is worth protecting from an accidental "Name it".
        myth = Namer.Myth(name: figure.name, myth: figure.note)
        nameIsMine = true
        connections += 1
    }

    // MARK: - Keeping and restoring

    /// Everything needed to bring this constellation back on any screen size.
    func snapshot(id: UUID = UUID()) -> SavedSky? {
        let drawn = singableLines.map { lines[$0] }
        guard !drawn.isEmpty else { return nil }
        let named = myth ?? Namer.unnamed
        let sky = SavedSky(id: id, seed: seed, fieldStarCount: fieldStarCount,
                           figureID: figureID,
                           lines: drawn.map(\.stars),
                           voices: drawn.map(\.instrument),
                           name: named.name, myth: named.myth)
        return sky.isCoherent ? sky : nil
    }

    func markKept(_ sky: SavedSky) { keptID = sky.id }

    /// Rebuilds the saved night from its seed and puts the constellation back on
    /// it. The star count comes from the entry, not the current screen, so a sky
    /// kept on a phone reopens intact on a tablet.
    func restore(_ sky: SavedSky) {
        guard sky.isCoherent else { return }
        stop()
        namingTask?.cancel()
        isNaming = false
        pulses = []
        shooters = []

        makeSky(seed: sky.seed, count: sky.fieldStarCount, figure: Atlas.figure(id: sky.figureID))
        lines = sky.savedLines
        activeLine = max(lines.count - 1, 0)
        for index in connectedStars where stars.indices.contains(index) { stars[index].isLit = true }
        // Whether this name was typed or suggested isn't recorded in the file,
        // so treat anything kept as settled. Asking before replacing it is the
        // cheap mistake; overwriting a name someone chose is the expensive one.
        myth = Namer.Myth(name: sky.name, myth: sky.myth)
        nameIsMine = true
        keptID = sky.id
        connections += 1
    }

    nonisolated static func starCount(for size: CGSize) -> Int {
        let area = max(size.width * size.height, 0)
        return min(max(Int(area / 5_000), 60), 260)
    }

    nonisolated static func makeStars<G: RandomNumberGenerator>(count: Int, using rng: inout G) -> [Star] {
        (0..<count).map { _ in
            Star(x: .random(in: 0.03...0.97, using: &rng),
                 y: .random(in: 0.12...0.82, using: &rng),
                 radius: .random(in: 0.8...2.4, using: &rng),
                 phase: .random(in: 0...(2 * .pi), using: &rng),
                 isBright: Double.random(in: 0...1, using: &rng) < 0.22)
        }
    }

    // MARK: - Drawing a constellation

    /// Point-size radius within which a touch grabs a star.
    nonisolated static func hitRadius(for size: CGSize) -> CGFloat {
        max(30, min(size.width, size.height) * 0.055)
    }

    func nearestStar(to point: CGPoint, in size: CGSize) -> Int? {
        guard size.width > 0, size.height > 0 else { return nil }
        var best: Int?
        var bestDistance = Self.hitRadius(for: size)
        for (index, star) in stars.enumerated() {
            let p = star.point(in: size)
            let d = hypot(p.x - point.x, p.y - point.y)
            if d < bestDistance {
                bestDistance = d
                best = index
            }
        }
        return best
    }

    /// Tap a star, or drag across several — either way this is the entry point.
    @discardableResult
    func connect(at point: CGPoint, in size: CGSize) -> Bool {
        guard let index = nearestStar(to: point, in: size) else { return false }
        return connect(starAt: index)
    }

    @discardableResult
    func connect(starAt index: Int) -> Bool {
        guard stars.indices.contains(index) else { return false }

        // Drawing over a loop starts a new line rather than extending the one
        // you are listening to. It only happens once per take — after that you
        // are simply drawing on the new line.
        if isPlaying, !openedLineThisTake, path.count >= 2 {
            openedLineThisTake = true
            startNewLine()
        }
        guard path.last != index else { return false }

        stars[index].isLit = true
        path.append(index)
        connections += 1
        myth = nil
        nameIsMine = false
        keptID = nil

        let star = stars[index]
        let pan = Float(star.x - 0.5) * 1.4
        Synth.shared.ping(Music.pitch(forY: star.y, in: tuning), instrument: instrument, pan: pan)
        pulses.append(Pulse(position: CGPoint(x: star.x, y: star.y), start: .now, line: nil))
        return true
    }

    /// Opens another line over the top, up to `maxLines`. If one is already
    /// playing, the new line joins in as soon as it has something to sing.
    @discardableResult
    func startNewLine() -> Bool {
        guard lines.count < Self.maxLines else { return false }
        lines.append(Line(instrument: instrument))
        activeLine = lines.count - 1
        keptID = nil
        if isPlaying { startLoop(for: activeLine) }
        return true
    }

    func undo() {
        guard let removed = path.popLast() else {
            // An empty line disappears, and drawing goes back to the one below.
            if lines.count > 1 {
                lines.remove(at: activeLine)
                loopTasks[activeLine]?.cancel()
                loopTasks[activeLine] = nil
                activeLine = min(activeLine, lines.count - 1)
            }
            return
        }
        // Only dim the star if no line passes through it any more.
        if !connectedStars.contains(removed) {
            stars[removed].isLit = false
        }
        myth = nil
        nameIsMine = false
        keptID = nil
    }

    // MARK: - Playback

    /// Starts every line looping. Each keeps its own cycle, so lines of
    /// different lengths drift against one another instead of marching in step
    /// — which is what makes two constellations sound like one piece of music
    /// rather than two takes of the same one.
    func play() {
        guard !isPlaying, hasSomethingToPlay else { return }
        isPlaying = true
        openedLineThisTake = false
        for line in lines.indices { startLoop(for: line) }
    }

    func stop() {
        for task in loopTasks.values { task.cancel() }
        loopTasks = [:]
        isPlaying = false
        openedLineThisTake = false
    }

    private func startLoop(for line: Int) {
        loopTasks[line]?.cancel()
        loopTasks[line] = Task { [weak self] in
            while !Task.isCancelled {
                guard let self, self.lines.indices.contains(line) else { return }
                let notes = self.stars(on: line)
                guard notes.count >= 2 else {
                    // Still being drawn. Look again shortly.
                    try? await Task.sleep(nanoseconds: 300_000_000)
                    continue
                }
                let cycle = self.soundOnce(notes, line: line)
                try? await Task.sleep(nanoseconds: UInt64(max(cycle, 0.2) * 1_000_000_000))
            }
        }
    }

    /// Schedules one time round a line, and says how long that takes.
    @discardableResult
    private func soundOnce(_ notes: [Star], line: Int) -> Double {
        let voice = lines.indices.contains(line) ? lines[line].instrument : .chime
        let starts = Music.schedule(for: notes)
        let durations = Music.durations(for: notes)
        let now = Date()

        for (i, star) in notes.enumerated() {
            let pan = Float(star.x - 0.5) * 1.4
            Synth.shared.ping(Music.pitch(forY: star.y, in: tuning),
                              instrument: voice,
                              delay: starts[i],
                              duration: durations[i],
                              volume: line == 0 ? 0.25 : 0.19,
                              pan: pan)
            pulses.append(Pulse(position: CGPoint(x: star.x, y: star.y),
                                start: now.addingTimeInterval(starts[i]),
                                line: line))
        }

        // Only the first line ticks, or layering would buzz continuously —
        // and only on the beats far enough apart to read as a pulse.
        if line == 0 {
            Task { [weak self] in
                var elapsed = 0.0
                for start in Music.feltBeats(in: starts) {
                    try? await Task.sleep(nanoseconds: UInt64(max(start - elapsed, 0) * 1_000_000_000))
                    guard !Task.isCancelled, self?.isPlaying == true else { return }
                    elapsed = start
                    self?.notePulse += 1
                }
            }
        }
        return Music.cycleLength(for: notes)
    }

    /// Plays a melody without disturbing the sky — used from the lists.
    static func preview(_ constellations: [[Star]], tuning: Music.Tuning = Music.default,
                        voices: [Instrument] = []) {
        for (line, notes) in constellations.enumerated() where notes.count >= 2 {
            let voice = line < voices.count ? voices[line] : .chime
            let starts = Music.schedule(for: notes)
            let durations = Music.durations(for: notes)
            for (i, star) in notes.enumerated() {
                let pan = Float(star.x - 0.5) * 1.4
                Synth.shared.ping(Music.pitch(forY: star.y, in: tuning),
                                  instrument: voice,
                                  delay: starts[i],
                                  duration: durations[i],
                                  volume: line == 0 ? 0.22 : 0.17,
                                  pan: pan)
            }
        }
    }

    // MARK: - Naming

    func nameIt() {
        guard canName else { return }
        isNaming = true
        let drawn = singableLines.map { stars(on: $0) }
        let voices = singableLines.map { lines[$0].instrument }
        namingTask?.cancel()
        namingTask = Task { [weak self] in
            let result = await Namer.myth(for: drawn, voices: voices)
            guard !Task.isCancelled else { return }
            self?.myth = result
            // Claude's suggestion, not a decision — replacing it needs no warning.
            self?.nameIsMine = false
            self?.isNaming = false
        }
    }

    // MARK: - Ambient motion

    /// Reaps faded effects and occasionally launches a shooting star.
    /// Called a few times a second — the rendering itself is frame-rate
    /// independent, so this never needs to run per frame.
    func advance(to now: Date, spawnChance: Double = 0.09) {
        pulses.removeAll { $0.hasFaded(at: now) }
        shooters.removeAll { $0.hasFaded(at: now) }
        guard Double.random(in: 0...1) < spawnChance, shooters.count < 3 else { return }
        shooters.append(Self.makeShooter(at: now))
    }

    nonisolated static func makeShooter(at now: Date) -> Shooter {
        let goingRight = Bool.random()
        let speed = Double.random(in: 0.30...0.55)
        return Shooter(origin: CGPoint(x: goingRight ? .random(in: -0.05...0.5) : .random(in: 0.5...1.05),
                                       y: .random(in: 0.02...0.45)),
                       velocity: CGVector(dx: goingRight ? speed : -speed,
                                          dy: Double.random(in: 0.08...0.20)),
                       start: now,
                       lifespan: Double.random(in: 1.1...1.8))
    }
}
