import XCTest
@testable import Starsong

final class InstrumentTests: XCTestCase {
    let sampleRate = 44_100.0

    // MARK: - Measuring what came out

    /// The strongest period in a signal, by autocorrelation. Skips the attack,
    /// where the noise burst has not yet settled into a pitch.
    func fundamental(of samples: [Float], sampleRate: Double,
                     from low: Double = 80, to high: Double = 3_000) -> Double? {
        let start = min(2_000, samples.count / 4)
        let window = Array(samples[start...]).map(Double.init)
        guard window.count > 2_000 else { return nil }

        let shortestLag = Int(sampleRate / high)
        let longestLag = min(Int(sampleRate / low), window.count / 2)
        guard shortestLag < longestLag else { return nil }

        var scores = [Double](repeating: 0, count: longestLag + 1)
        for lag in shortestLag...longestLag {
            var score = 0.0
            var energy = 1e-12
            for i in 0..<(window.count - lag) {
                score += window[i] * window[i + lag]
                energy += window[i] * window[i]
            }
            scores[lag] = score / energy
        }

        var bestLag = shortestLag
        for lag in shortestLag...longestLag where scores[lag] > scores[bestLag] { bestLag = lag }
        guard bestLag > shortestLag, bestLag < longestLag else {
            return bestLag > 0 ? sampleRate / Double(bestLag) : nil
        }

        // One integer lag is 68 cents wide at 1760 Hz, so a whole-bin answer
        // cannot tell a tuned string from a badly detuned one. Fit a parabola
        // through the peak and its neighbours for the sub-sample position.
        let before = scores[bestLag - 1], peak = scores[bestLag], after = scores[bestLag + 1]
        let denominator = before - 2 * peak + after
        let offset = abs(denominator) < 1e-12 ? 0 : 0.5 * (before - after) / denominator
        return sampleRate / (Double(bestLag) + offset)
    }

    func rms(_ samples: [Float]) -> Double {
        guard !samples.isEmpty else { return 0 }
        return (samples.reduce(0.0) { $0 + Double($1) * Double($1) } / Double(samples.count)).squareRoot()
    }

    /// Rough brightness: how high the energy sits, by counting sign changes.
    func brightness(of samples: [Float]) -> Double {
        guard samples.count > 1 else { return 0 }
        var crossings = 0
        for i in 1..<samples.count where (samples[i] < 0) != (samples[i - 1] < 0) {
            crossings += 1
        }
        return Double(crossings) / Double(samples.count)
    }

    // MARK: - Pitch

    /// Karplus-Strong's pitch comes out of the delay line's length, and rounding
    /// it to whole samples is the classic way to get this subtly wrong — at the
    /// top of the sky it lands a third of a semitone flat. So measure it.
    func testPluckPlaysThePitchItWasAskedFor() throws {
        for frequency in [220.0, 330.0, 440.0, 660.0, 880.0, 1_320.0, 1_760.0] {
            let samples = Instrument.pluck.samples(frequency: frequency, duration: 1.5,
                                                   sampleRate: sampleRate)
            let heard = try XCTUnwrap(fundamental(of: samples, sampleRate: sampleRate),
                                      "no pitch found at \(frequency) Hz")
            let cents = 1200 * log2(heard / frequency)
            XCTAssertLessThan(abs(cents), 12,
                              "asked for \(frequency) Hz, got \(Int(heard)) Hz — \(Int(cents)) cents out")
        }
    }

    /// The pitched voices should all agree on what a note is.
    func testEveryPitchedVoiceAgreesOnTheNote() throws {
        for instrument in Instrument.allCases where instrument != .bell {
            let samples = instrument.samples(frequency: 440, duration: 1.2, sampleRate: sampleRate)
            let heard = try XCTUnwrap(fundamental(of: samples, sampleRate: sampleRate),
                                      "\(instrument.name) has no discernible pitch")
            let cents = 1200 * log2(heard / 440)
            XCTAssertLessThan(abs(cents), 25, "\(instrument.name) is \(Int(cents)) cents out")
        }
    }

    // MARK: - Every voice is well behaved

    func testNoVoiceClipsOrGoesSilentOrClicks() {
        for instrument in Instrument.allCases {
            for frequency in [220.0, 880.0] {
                let samples = instrument.samples(frequency: frequency, duration: 1.0,
                                                 sampleRate: sampleRate)
                let label = "\(instrument.name) at \(Int(frequency))Hz"

                XCTAssertEqual(samples.count, Int(sampleRate), label)
                XCTAssertTrue(samples.allSatisfy { $0.isFinite }, "\(label) produced NaN or infinity")
                XCTAssertTrue(samples.allSatisfy { abs($0) <= 1.0 }, "\(label) clips")
                XCTAssertGreaterThan(rms(samples), 0.01, "\(label) is silent")

                // A note that starts or ends on a step is a click.
                XCTAssertLessThan(abs(samples.first!), 0.05, "\(label) begins with a click")
                XCTAssertLessThan(abs(samples.last!), 0.05, "\(label) ends with a click")
            }
        }
    }

    func testShortAndOddDurationsDoNotBreakAnything() {
        for instrument in Instrument.allCases {
            for duration in [0.05, 0.2, 2.4] {
                let samples = instrument.samples(frequency: 440, duration: duration,
                                                 sampleRate: sampleRate)
                XCTAssertEqual(samples.count, Int(duration * sampleRate), instrument.name)
                XCTAssertTrue(samples.allSatisfy { $0.isFinite }, instrument.name)
            }
        }
    }

    /// Very high notes make the delay line short enough to fall apart.
    func testAbsurdPitchesAreHandled() {
        for instrument in Instrument.allCases {
            let samples = instrument.samples(frequency: 18_000, duration: 0.3, sampleRate: sampleRate)
            XCTAssertTrue(samples.allSatisfy { $0.isFinite }, "\(instrument.name) at 18kHz")
        }
    }

    func testTheSameNoteRendersIdenticallyEveryTime() {
        // Pluck starts from noise; if that noise were not seeded, caching a note
        // would return something different from what was first heard.
        let first = Instrument.pluck.samples(frequency: 440, duration: 1, sampleRate: sampleRate)
        let second = Instrument.pluck.samples(frequency: 440, duration: 1, sampleRate: sampleRate)
        XCTAssertEqual(first, second)
    }

    func testStereoPanningParamDoesNotCrash() {
        for pan in [-1.0, -0.5, 0.0, 0.5, 1.0] {
            Synth.shared.ping(440.0, instrument: .marimba, delay: 0, duration: 0.5, volume: 0.2, pan: Float(pan))
            Synth.shared.ping(550.0, instrument: .pad, delay: 0.1, duration: 0.5, volume: 0.2, pan: Float(pan))
            Synth.shared.ping(660.0, instrument: .harp, delay: 0.2, duration: 0.5, volume: 0.2, pan: Float(pan))
        }
    }

    // MARK: - The one that matters

    /// Five tunings shipped that were nearly the same scale, because they were
    /// picked by ear and never measured. Not doing that again with timbres:
    /// every pair of voices has to differ measurably in brightness or in how it
    /// decays, or there is no point having both.
    func testNoTwoVoicesSoundAlike() {
        struct Fingerprint {
            let name: String
            let brightness: Double
            let decay: Double      // how much quieter the tail is than the head
        }

        let prints = Instrument.allCases.map { instrument -> Fingerprint in
            let samples = instrument.samples(frequency: 440, duration: 1.5, sampleRate: sampleRate)
            let head = Array(samples[0..<(samples.count / 5)])
            let tail = Array(samples[(samples.count * 3 / 5)...])
            return Fingerprint(name: instrument.name,
                               brightness: brightness(of: samples),
                               decay: rms(head) / Swift.max(rms(tail), 1e-6))
        }

        for i in prints.indices {
            for j in (i + 1)..<prints.count {
                let a = prints[i], b = prints[j]
                let brightnessRatio = Swift.max(a.brightness, b.brightness)
                    / Swift.max(Swift.min(a.brightness, b.brightness), 1e-9)
                let decayRatio = Swift.max(a.decay, b.decay)
                    / Swift.max(Swift.min(a.decay, b.decay), 1e-9)
                XCTAssertTrue(brightnessRatio > 1.25 || decayRatio > 1.6,
                              "\(a.name) and \(b.name) are too alike — brightness x\(String(format: "%.2f", brightnessRatio)), decay x\(String(format: "%.2f", decayRatio))")
            }
        }
    }
}

@MainActor
final class LineVoiceTests: XCTestCase {
    let size = CGSize(width: 390, height: 844)

    func drawing() -> SkyModel {
        let model = SkyModel()
        model.newSky(for: size, seed: 41)
        model.connect(starAt: 0)
        model.connect(starAt: 1)
        return model
    }

    func testALineStartsOnTheChimeAndKeepsWhatYouChoose() {
        let model = drawing()
        XCTAssertEqual(model.instrument, .chime)
        model.setInstrument(.pluck)
        XCTAssertEqual(model.instrument, .pluck)
        XCTAssertEqual(model.lines[0].instrument, .pluck)
    }

    /// The whole point of per-line voices: a piano melody over a plucked line.
    func testEachLineKeepsItsOwnVoice() {
        let model = drawing()
        model.setInstrument(.piano)
        model.startNewLine()
        model.connect(starAt: 10)
        model.connect(starAt: 11)
        model.setInstrument(.pluck)

        XCTAssertEqual(model.lines.map(\.instrument), [.piano, .pluck])
        XCTAssertEqual(model.instrument, .pluck, "the active line is the second one")
    }

    /// A new line inherits the voice you were last using, rather than snapping
    /// back to the chime and making you choose again.
    func testANewLineInheritsTheVoiceYouWerePlayingIn() {
        let model = drawing()
        model.setInstrument(.bell)
        model.startNewLine()
        XCTAssertEqual(model.instrument, .bell)
    }

    func testANewSkyKeepsTheVoiceToo() {
        let model = drawing()
        model.setInstrument(.brass)
        model.newSky(for: size, seed: 9)
        XCTAssertEqual(model.instrument, .brass)
    }

    func testChangingVoiceMeansTheKeptCopyIsOutOfDate() {
        let model = drawing()
        let saved = model.snapshot()!
        model.markKept(saved)
        XCTAssertNotNil(model.keptID)
        model.setInstrument(.bell)
        XCTAssertNil(model.keptID, "the kept sky no longer matches what you can hear")
    }

    // MARK: - Keeping

    func testVoicesSurviveBeingKeptAndReopened() throws {
        let model = drawing()
        model.setInstrument(.piano)
        model.startNewLine()
        model.connect(starAt: 20)
        model.connect(starAt: 21)
        model.setInstrument(.bell)

        let saved = try XCTUnwrap(model.snapshot())
        XCTAssertEqual(saved.voices, [.piano, .bell])

        let reopened = SkyModel()
        reopened.newSky(for: size, seed: 3)
        reopened.restore(saved)
        XCTAssertEqual(reopened.lines.map(\.instrument), [.piano, .bell])
        XCTAssertEqual(reopened.lineStars, model.lineStars)
    }

    /// A sky kept before there were voices was played on the chime, and has to
    /// come back sounding the way it did.
    func testSkiesKeptBeforeVoicesExistedComeBackAsChime() throws {
        let old = """
        {"id":"3C2A5E10-9B77-4A31-8D0C-1F2E3A4B5C6D","seed":42,"starCount":60,
         "lines":[[1,2,3],[4,5]],"name":"Two Lines","myth":"A story.",
         "keptAt":"2026-08-23T10:00:00Z"}
        """
        let decoder = JSONDecoder()
        decoder.dateDecodingStrategy = .iso8601
        let sky = try decoder.decode(SavedSky.self, from: Data(old.utf8))
        XCTAssertEqual(sky.voices, [.chime, .chime])
        XCTAssertTrue(sky.isCoherent)
    }

    /// A file whose voices have got out of step with its lines is repaired, not
    /// dropped — losing a constellation over a wrong instrument would be a poor
    /// trade.
    func testAMismatchedVoiceListIsRepairedRatherThanLosingTheSky() throws {
        let ragged = """
        {"id":"9F8E7D6C-5B4A-3928-1706-5F4E3D2C1B0A","seed":7,"starCount":50,
         "lines":[[1,2],[3,4],[5,6]],"voices":["pluck"],"name":"Ragged",
         "myth":"x","keptAt":"2026-08-23T10:00:00Z"}
        """
        let decoder = JSONDecoder()
        decoder.dateDecodingStrategy = .iso8601
        let sky = try decoder.decode(SavedSky.self, from: Data(ragged.utf8))
        XCTAssertEqual(sky.voices, [.pluck, .chime, .chime])
        XCTAssertTrue(sky.isCoherent)
        XCTAssertEqual(sky.savedLines.count, 3)
    }

    func testAnUnknownVoiceInAFileDoesNotCrash() {
        let bogus = """
        {"id":"1A2B3C4D-5E6F-7081-92A3-B4C5D6E7F809","seed":1,"starCount":40,
         "lines":[[1,2]],"voices":["theremin"],"name":"Odd","myth":"x",
         "keptAt":"2026-08-23T10:00:00Z"}
        """
        let decoder = JSONDecoder()
        decoder.dateDecodingStrategy = .iso8601
        XCTAssertThrowsError(try decoder.decode(SavedSky.self, from: Data(bogus.utf8)),
                             "an unknown voice should fail decoding, and the log drops the entry")
    }

    func testTheNamingPromptSaysWhichVoiceEachLineUses() {
        let line = [Star(x: 0.2, y: 0.3, radius: 1, phase: 0, isBright: false),
                    Star(x: 0.6, y: 0.5, radius: 1, phase: 0, isBright: false)]
        let prompt = Namer.prompt(for: [line], voices: [.pluck])
        XCTAssertTrue(prompt.contains("pluck"), prompt)
    }
}
